{
  "name": "pfc-launcher",
  "version": "1.7.5",
  "description": "FCore Launcher — крутой лаунчер для тех, кто проживает в морге, помогите!!!",
  "main": "main.js",
  "author": "Awskull",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "ensure-release": "node scripts/ensureGithubRelease.js",
    "publish-release-notes": "node scripts/publishReleaseNotes.js",
    "test": "node --test \"tests/*.test.js\"",
    "i18n:check": "node tools/i18n-check.js"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-store": "^8.2.0",
    "msmc": "^5.0.5",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "node-fetch": "^2.7.0",
    "open": "^11.0.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pfc.launcher",
    "productName": "FCore Launcher",
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "MRBOMBOCLATTT",
      "repo": "FCore-Launcher",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "resources/**/*",
      "build/icon.png",
      "!src/main.js",
      "!src/preload.js",
      "!src/renderer/**",
      "!src/src/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FCore Launcher"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
